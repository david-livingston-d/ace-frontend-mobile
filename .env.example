# Same value on both platforms: Android reaches it through `adb reverse tcp:8000 tcp:8000`,
# the iOS simulator shares the Mac's localhost directly. Plaintext http is allowed in dev by
# `NSAllowsLocalNetworking` in ios/AceSales/Info.plist (arbitrary loads stay off).
API_URL=http://localhost:8000
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ENV=dev
