<resources>
    <!-- API 29+ adds a translucent scrim behind a transparent navigation bar
         unless this is turned off — it reads as a grey band under the tab bar. -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
