<resources>
    <!-- Dark mode on API 29+: the night theme's light status- *and*
         navigation-bar icons, and the contrast scrim turned off. The night
         qualifier outranks the API one, so `values-night` alone would silently
         drop both the scrim opt-out and the nav-bar icon colour. -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
